#include <iostream>
#include <fstream>
#include <string>

int main() {
    const std::string filename = "students.csv";

    std::fstream file(filename, std::ios::out | std::ios::trunc);
    if (!file) {
        std::cerr << "Error opening file for writing!\n";
        return 1;
    }

    file << "ID,Name,Marks\n";
    file << "101,Aarav,85\n";
    
    std::streampos posBeforeUpdate = file.tellp();
    std::cout << "Put pointer (tellp) after second line: " << posBeforeUpdate << " bytes\n";

    file << "102,Rohan,00\n";
    file << "103,Ananya,92\n";

    file.seekp(posBeforeUpdate + std::streamoff(10));
    file << "89";

    file.close();

    file.open(filename, std::ios::in);
    if (!file) {
        std::cerr << "Error opening file for reading!\n";
        return 1;
    }

    file.seekg(0, std::ios::end);
    std::streampos fileSize = file.tellg();
    std::cout << "Total CSV File Size (tellg at end): " << fileSize << " bytes\n\n";

    file.seekg(0, std::ios::beg);

    std::cout << "--- Stored Student Records (CSV) ---\n";
    std::string line;
    while (std::getline(file, line)) {
        std::cout << "Pos [" << file.tellg() << "]: " << line << "\n";
    }

    file.close();
    return 0;
}
