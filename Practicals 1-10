#include <iostream>
#include <vector>
#include <map>
#include <unordered_map>
#include <algorithm>
#include <string>

struct Student {
    int id;
    std::string name;
    int marks;
};

int main() {
    std::vector<Student> students = {
        {103, "Rohan", 78},
        {101, "Aarav", 92},
        {104, "Sneha", 65},
        {102, "Ananya", 88}
    };

    std::sort(students.begin(), students.end(), [](const Student& a, const Student& b) {
        return a.marks > b.marks;
    });

    std::cout << "--- Sorted Students (By Marks Descending) ---\n";
    for (const auto& s : students) {
        std::cout << s.id << " - " << s.name << ": " << s.marks << "\n";
    }

    auto topScorer = std::find_if(students.begin(), students.end(), [](const Student& s) {
        return s.marks > 90;
    });

    if (topScorer != students.end()) {
        std::cout << "\nTop Scorer (>90): " << topScorer->name << " (" << topScorer->marks << ")\n";
    }

    std::vector<int> updatedMarks(students.size());
    std::transform(students.begin(), students.end(), updatedMarks.begin(), [](const Student& s) {
        return std::min(100, s.marks + 5);
    });

    std::cout << "\n--- Updated Marks (+5 Grace) ---\n";
    for (size_t i = 0; i < students.size(); ++i) {
        std::cout << students[i].name << ": " << updatedMarks[i] << "\n";
    }

    std::map<int, std::string> sortedDirectory;
    std::unordered_map<std::string, int> fastMarksLookup;

    for (size_t i = 0; i < students.size(); ++i) {
        sortedDirectory[students[i].id] = students[i].name;
        fastMarksLookup[students[i].name] = updatedMarks[i];
    }

    std::cout << "\n--- Sorted Directory (std::map by Roll No) ---\n";
    for (const auto& pair : sortedDirectory) {
        std::cout << "ID " << pair.first << ": " << pair.second << "\n";
    }

    std::cout << "\n--- Fast Lookup (std::unordered_map) ---\n";
    std::cout << "Ananya's Updated Marks: " << fastMarksLookup["Ananya"] << "\n";

    return 0;
}

